# ==============================================================================
# CAMARCA S.A.S. - VARIABLES DE ENTORNO Y CONFIGURACIÓN DEL SISTEMA
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. BASE DE DATOS PRINCIPAL: CLOUD SQL (POSTGRESQL)
# ------------------------------------------------------------------------------
# Opción A: URL de conexión estándar (Recomendada para conexión directa o Supabase/Neon/RDS)
DATABASE_URL="postgresql://app_user:tu_password_seguro@127.0.0.1:5432/camarca_postgres?sslmode=disable"

# Opción B: Parámetros individuales de conexión
SQL_HOST="127.0.0.1"
SQL_PORT="5432"
SQL_USER="app_user"
SQL_PASSWORD="tu_password_seguro"
SQL_DB_NAME="camarca_postgres"
SQL_SSL="false"

# Configuración del Pool de Conexiones PostgreSQL
SQL_POOL_MAX="20"
SQL_IDLE_TIMEOUT_MS="30000"
SQL_CONN_TIMEOUT_MS="5000"

# ------------------------------------------------------------------------------
# 2. ENTORNO DE EJECUCIÓN Y URLS DE APLICACIÓN
# ------------------------------------------------------------------------------
NODE_ENV="production"
APP_ENV="published"
APP_URL="https://tu-dominio-o-servicio.run.app"
PORT="3000"

# ------------------------------------------------------------------------------
# 3. SEGURIDAD Y CLAVE MAESTRA ADMINISTRATIVA
# ------------------------------------------------------------------------------
ADMIN_MASTER_PASSWORD="tu_password_maestro_admin"
ADMIN_MASTER_PASSWORD_HASH=""
JWT_SECRET="clave_secreta_para_firmar_tokens_de_sesion_camarca_2026"

# ------------------------------------------------------------------------------
# 4. INTEGRACIÓN CON GOOGLE WORKSPACE & GOOGLE DRIVE
# ------------------------------------------------------------------------------
# ID de la hoja de cálculo Google Sheets (respaldo secundario)
GOOGLE_SPREADSHEET_ID="1kYPyKJNXmK3sNmUl77-F3Ugb8OuW8QHeWbXZ8mEfVPQ"
GOOGLE_DRIVE_FOLDER_ID="1k5qEwXzAbCdEfGhIjKlMnOpQrStUv"

# ------------------------------------------------------------------------------
# 5. INTELIGENCIA ARTIFICIAL (GEMINI API)
# ------------------------------------------------------------------------------
GEMINI_API_KEY="AIzaSyTuClaveDeGoogleGeminiAPI"

# ------------------------------------------------------------------------------
# 6. ALMACENAMIENTO CLOUD AWS S3 (CAPA 1 PRIMARIA DE FOTOGRAFÍAS)
# ------------------------------------------------------------------------------
